# ============================================================================
# 自定义追加（N60 Pro 6.6 全依赖版，2026-10-26 修正）
#
# 原则：
#   A 类 kmod —— immortalwrt_core 源 404，opkg 装不了内核模块，必须一次编全。
#   B 类用户态 —— extroot 后随时 opkg 装，只编「确定要 + 开箱即用」的。
# 说明：6.6 主线 OpenWrt 的内核默认已开启 cgroup/namespace/loop/overlay 等
#       Docker 所需特性，无需（也不应）再往内核 config 手动追加符号。
# ============================================================================

# ########## A 类：内核模块（不可后装，只留真正需要的）##########

# --- 容器/Docker 硬依赖 kmod（dockerd 必需）---
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-loop=y

# --- NAT / 转发（dockerd 硬依赖 + 端口转发保障）---
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-ipt-physdev=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# --- 代理基础（nft 与 iptables 两套都留）---
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y

# --- PPPoE 拨号（稳定优先，务必在）---
# 说明：ppp + ppp-mod-pppoe（用户态守护进程）已由 DEFAULT_PACKAGES.router 自动带上，
#       luci-proto-ppp（LuCI 拨号界面）已由 luci-light 自动带上；以下 kmod 是内核侧模块，
#       冗余但显式声明可确保不因 DEVICE_PACKAGES 清空而被剥离。
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y

# --- PPPoE 用户态显式加固（防止 make defconfig 剥离默认包后拨号失败）---
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# --- 拨号稳定性：SQM 的 cake 算法内核模块 + VLAN(802.1Q，IPTV 单线复用可能用到) ---
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-8021q=y

# --- 文件系统（extroot 核心；ext4/f2fs 6.6 内核已内建，这里补 exfat/vfat/ntfs 等外接）---
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# --- USB 存储（UASP 留着，换硬盘盒不用重编）---
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

# --- USB 有线网卡（RTL8152/RNDIS/CDC，USB 口当第二 WAN/旁路由备用，体积小但 opkg 装不了）---
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# --- 磁盘温度监控（drivetemp hwmon，外接硬盘/SSD 温度显示，配合 luci-app-statistics）---
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-hwmon-drivetemp=y

# --- CUPS 打印服务器（USB 打印机类驱动 → /dev/usb/lp0，无它 CUPS 收作业但写不进设备）---
#   配套用户态：cups（可选 cups-bjnp 佳能/cups-filters），extroot 后 opkg 装。
#   MT7986 是 USB3 控制器（kmod-usb3 已声明），向下兼容 USB2 打印机，无需再补 usb-ohci/ehci。
CONFIG_PACKAGE_kmod-usb-printer=y

# --- 网络共享 ksmbd（内核态 SMB2/3 文件服务器）依赖的 crypto/asn1 模块 ---
#   kmod-fs-ksmbd 的 DEPENDS 链：nls-base/utf8、crypto-md4/md5/hmac/des/sha256/cmac/sha512/
#   ccm/gcm 均已就位（上方 crypto 区）；还缺 aead/ecb/asn1-decoder/oid-registry 四个，
#   此处补齐。kmod-fs-ksmbd 本体在 B 类声明（见下方「网络共享」区）。
#   注：若只做简单共享，也可改用 Samba4（纯用户态、零内核模块）；ksmbd 性能更好但依赖 crypto 链。
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-ecb=y
CONFIG_PACKAGE_kmod-asn1-decoder=y
CONFIG_PACKAGE_kmod-oid-registry=y

# --- 隧道 / VPN ---
# WireGuard 完整三件套（内核模块 + wg 命令 + LuCI 协议界面）
#   kmod-wireguard：内核协议栈（A 类 kmod，不可后装）
#   wireguard-tools：wg/wg-quick 命令（生成密钥、查状态）
#   luci-proto-wireguard：LuCI「网络→接口」里的 WireGuard VPN 协议
# 注：24.10 上正确包名是 luci-proto-wireguard（luci-app-wireguard 已于 2024 年移除，
#   写了会 defconfig 报错）。
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ########## B 类：用户态（开箱即用，按需编入）##########

# --- PassWall2（6.6 线是 fw4/nftables，必须用二代）+ xray 核心 ---
# 依赖链已核对（helloworld feed）：
#   xray-core + v2ray-geoip + v2ray-geosite 为核心；nft 模式还需 kmod-nft-tproxy/socket（上方 A 类已声明）。
#   kmod-nft-nat 由 firewall4（DEFAULT_PACKAGES.router 默认包）自动带入，无需手动声明。
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
# PassWall2 节点测速/后台运行软依赖（显式声明，避免 helloworld 依赖链遗漏）
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_coreutils-nohup=y

# --- homeproxy（sing-box 核心，现代化代理平台）---
# 依赖链已核对（LUCI_DEPENDS=sing-box + firewall4 + kmod-nft-tproxy + ucode-mod-digest）：
#   firewall4/kmod-nft-tproxy 已在默认包/A 类；sing-box 在 packages feed（net/sing-box）；
#   ucode-mod-digest 是 immortalwrt 特有包（ucode 加密摘要库）。
# ⚠️ 运行时注意：homeproxy 与 PassWall2 均会接管 DNS(53)+nftables 规则，二者只能「开一个」，
#    切勿同时启用，否则互相抢 53 端口与分流规则导致全局断网（详见 README）。
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_ucode-mod-digest=y

# --- 通用工具（homeproxy/PassWall2/系统均会用到）---
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y

# --- 宽带稳定三件套（watchcat 断网自动重启 + arpbind IP/MAC 绑定 + sqm 智能 QoS）---
# ⚠️ HNAT + PPPoE 掉线兜底（本机最重要的一条稳定性措施）：
#   237 源码（本线源头）存在已知 bug：长时间拨号后可能 PPPoE 掉线且无法自动重拨，
#   需重启路由。对策：
#   1) watchcat 设「定期 ping 外网 IP(如 223.5.5.5) 失败 N 次 → 重启 WAN/整机」，实现掉线自愈。
#   2) 若掉线仍频发，在 LuCI「网络→Turbo ACC」里临时关掉 HNAT/硬件加速，走纯 CPU 转发（千兆内无感）。
#   3) 保持 flow-offload 关闭（上方 FLOW_OFFLOADING is not set 已做），避免与 HNAT 双重加速冲突。
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-sqm=y

# --- 家用功能扩展（内核模块已在上方 A 类补全，这里编用户态开箱即用）---
# CUPS 打印服务器：内核模块 kmod-usb-printer 已在 A 类；cups 用户态体积大(~15MB+依赖)，
#   建议 extroot 后 opkg install cups，或按需编入。
# 网络共享 ksmbd：内核模块 kmod-fs-ksmbd 及其 crypto/asn1 依赖已在 A 类补齐，
#   这里编入 ksmbd-server + luci-app-ksmbd 实现 SMB 共享开箱即用（轻量、内核态、性能好）。
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y

# --- iStore：不编，extroot 后 opkg 装（省 5MB，它本来就是装插件用的）---
#   opkg update && opkg install luci-app-store

# --- Docker 用户态：不编（约 200MB，编进去必爆闪存）---
# extroot 之后执行：
#   opkg update && opkg install dockerd docker containerd runc tini
# 内核侧 cgroup/namespace 6.6 主线默认已开，可直接跑。
